{
  "realm": "nepal-demo",
  "enabled": true,
  "displayName": "NepalID · demonstration identity provider",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "nepal-demo",
      "name": "Nepal Digital Services Demo",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-demo-only-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/auth/callback",
        "http://localhost:8085/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://localhost:8085"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "interagency-api",
      "name": "Federated agency API resource audience",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "interagency-broker",
      "name": "Government data exchange broker (synthetic M2M)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "broker-local-example-secret-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "agency-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "interagency-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "agency-transport-probe",
      "name": "Limited transport-only test client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "transport-local-example-secret-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "agency-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "interagency-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
